#!/bin/sh
# Conventional Commits format validator
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow merge, squash, and revert commits generated by git
if echo "$COMMIT_MSG" | grep -E "^(Merge|Revert |revert:)" > /dev/null 2>&1; then
    exit 0
fi

PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\-\/]+\))?: .+"

if ! echo "$COMMIT_MSG" | grep -E "$PATTERN" > /dev/null 2>&1; then
    echo "❌ Invalid commit message format."
    echo "   Subject was: \"$COMMIT_MSG\""
    echo ""
    echo "   Commit messages must follow the Conventional Commits format:"
    echo "     <type>(<optional-scope>): <short description>"
    echo ""
    echo "   Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo "   Example: feat(ble): add resistance floor bailout"
    echo "   Example: fix(wear): throttle 1Hz telemetry sync"
    echo "   Example: chore: configure spotless and pre-commit hooks"
    exit 1
fi

exit 0
